<% pageClass = "page-home"; %>
<% pageTitle = "Home"; %>
<% layout("layouts/boilerplate") %>

<section class="page-section page-home-intro">
  <div class="container">
    <div class="intro-copy fade-up">
      <h1 class="editorial-title">The homepage now points people somewhere useful instead of just decorating the screen.</h1>
      <p class="editorial-subtitle">This direction keeps the visual energy, but gives the page a stronger purpose: search, browse, compare, and host.</p>
    </div>
  </div>
</section>

<section class="page-section home-hero-top">
  <div class="container">
    <div class="quote-card fade-up">
      <div class="quote-card-inner">
        <div class="quote-text">"It no longer feels like every element is shouting. That alone makes browsing better."</div>
        <div class="quote-author-row">
          <div class="quote-avatar">
            <div class="quote-avatar-inner">🙂</div>
          </div>
          <div class="quote-author-meta">
            <h2>Emma Williams</h2>
            <p>Remote worker</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="page-section home-hero-dark">
  <div class="container">
    <div class="dark-panel fade-up">
      <div class="dark-panel-icon"></div>
      <div class="dark-panel-header">
        <h1>Homify</h1>
        <p>A calmer way to discover memorable places to stay.</p>
      </div>

      <p class="dark-panel-copy">We’re turning the product into something clearer, more trustworthy, and easier to navigate for both guests and hosts.</p>

      <div class="mini-dots" aria-label="Feature highlights">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="dark-panel-links">
        <div>
          <span>Explore</span>
          <a href="/listings">Browse stays</a>
        </div>
        <div>
          <span>Account</span>
          <a href="/login">Log in</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="page-section" aria-labelledby="why-built-heading">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <h2 id="why-built-heading" class="section-title">Why I built HomiFy</h2>
        <p class="text-soft">Finding a place to stay can quickly become overwhelming when listings, prices, locations, and amenities are scattered across multiple places. I built HomiFy as an independent full-stack project to explore a simpler way for students and travelers to discover, compare, and save stays.</p>
      </div>
      <div class="col-lg-4">
        <div class="card" style="background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--border);">
          <div class="card-body">
            <h3 class="h6 mb-2">Built by</h3>
            <div class="fw-bold">Amit Ghugal</div>
            <p class="mb-2 text-soft">Independent Full-Stack Project — Student Accommodation Platform</p>
            <div class="d-flex gap-2">
              <a class="btn btn-outline-secondary btn-sm" href="https://github.com/AmitGhugal123/Homify" target="_blank" rel="noopener">View source</a>
              <!-- LinkedIn not provided; keep link placeholder until provided -->
              <a class="btn btn-outline-secondary btn-sm" href="#" aria-disabled="true" title="LinkedIn link not provided">LinkedIn</a>
            </div>
          </div>
        </div>

        <div class="mt-3 card" style="background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--border);">
          <div class="card-body">
            <h3 class="h6 mb-2">Built with</h3>
            <ul class="list-unstyled text-soft mb-0">
              <li><strong>Frontend</strong> — Server-side rendered EJS, Bootstrap, FontAwesome</li>
              <li><strong>Backend</strong> — Node.js &amp; Express</li>
              <li><strong>Database</strong> — MongoDB via Mongoose</li>
              <li><strong>Auth</strong> — Passport (local)</li>
              <li><strong>Storage</strong> — Cloudinary (image uploads)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
