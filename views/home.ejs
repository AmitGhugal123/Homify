<% pageClass = "page-home"; %>
<% pageTitle = "Home"; %>
<% layout("layouts/boilerplate") %>

<section class="page-section page-home-intro">
  <div class="container">
    <div class="intro-copy fade-up">
      <h1 class="editorial-title">The homepage now points people somewhere useful instead of just decorating the screen.</h1>
      <p class="editorial-subtitle">This direction keeps the visual energy, but gives the page a stronger purpose: search, browse, compare, and host.</p>
    </div>
  </div>
</section>

<section class="page-section home-hero-top">
  <div class="container">
    <div class="quote-card fade-up">
      <div class="quote-card-inner">
        <div class="quote-text">"It no longer feels like every element is shouting. That alone makes browsing better."</div>
        <div class="quote-author-row">
          <div class="quote-avatar">
            <div class="quote-avatar-inner">🙂</div>
          </div>
          <div class="quote-author-meta">
            <h2>Emma Williams</h2>
            <p>Remote worker</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="page-section home-hero-dark">
  <div class="container">
    <div class="dark-panel fade-up">
      <div class="dark-panel-icon"></div>
      <div class="dark-panel-header">
        <h1>Homify</h1>
        <p>A calmer way to discover memorable places to stay.</p>
      </div>

      <p class="dark-panel-copy">We’re turning the product into something clearer, more trustworthy, and easier to navigate for both guests and hosts.</p>

      <div class="mini-dots" aria-label="Feature highlights">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="dark-panel-links">
        <div>
          <span>Explore</span>
          <a href="/listings">Browse stays</a>
        </div>
        <div>
          <span>Account</span>
          <a href="/login">Log in</a>
        </div>
      </div>
    </div>
  </div>
</section>
